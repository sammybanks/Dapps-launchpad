// List of cryptocurrencies to display (corrected IDs)
const cryptocurrencies = [
    'bitcoin', 'ethereum', 'binancecoin', 'ripple', 'solana',
    'cardano', 'dogecoin', 'polkadot', 'polygon', 'avalanche',
    'cosmos', 'litecoin', 'chainlink', 'uniswap', 'bitcoin-cash'
];

// Fetch data from CoinGecko API
async function fetchCryptoPrices() {
    try {
        const response = await fetch(
            `https://api.coingecko.com/api/v3/simple/price?ids=${cryptocurrencies.join(',')}&vs_currencies=usd&include_24hr_change=true`
        );
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        
        // Clear previous content
        const tickerContainer = document.getElementById('tickerContainer');
        tickerContainer.innerHTML = '';
        
        // Create ticker items for each cryptocurrency
        cryptocurrencies.forEach(cryptoId => {
            if (data[cryptoId]) {
                const crypto = data[cryptoId];
                const tickerItem = document.createElement('div');
                tickerItem.className = 'ticker-item';
                
                const change24h = crypto.usd_24h_change || 0;
                const changeClass = change24h >= 0 ? 'price-up' : 'price-down';
                const changeSymbol = change24h >= 0 ? '▲' : '▼';
                
                // Get the symbol from the ID (simplified version)
                const symbolMap = {
                    'bitcoin': 'BTC',
                    'ethereum': 'ETH',
                    'binancecoin': 'BNB',
                    'ripple': 'XRP',
                    'solana': 'SOL',
                    'cardano': 'ADA',
                    'dogecoin': 'DOGE',
                    'polkadot': 'DOT',
                    'polygon': 'MATIC',
                    'avalanche': 'AVAX',
                    'cosmos': 'ATOM',
                    'litecoin': 'LTC',
                    'chainlink': 'LINK',
                    'uniswap': 'UNI',
                    'bitcoin-cash': 'BCH'
                };
                
                tickerItem.innerHTML = `
                    <span class="crypto-name">${symbolMap[cryptoId]}</span>
                    <span class="crypto-price">$${crypto.usd.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span>
                    <span class="crypto-change ${changeClass}">
                        ${changeSymbol} ${Math.abs(change24h).toFixed(2)}%
                    </span>
                `;
                
                tickerContainer.appendChild(tickerItem);
            }
        });
        
        // Duplicate the content for seamless looping
        tickerContainer.innerHTML += tickerContainer.innerHTML;
        
    } catch (error) {
        console.error('Error fetching crypto prices:', error);
        // Fallback static data if API fails
        const tickerContainer = document.getElementById('tickerContainer');
        tickerContainer.innerHTML = `
            <div class="ticker-item"><span class="crypto-name">BTC</span> <span class="crypto-price">$60,000</span> <span class="crypto-change price-up">▲ 2.5%</span></div>
            <div class="ticker-item"><span class="crypto-name">ETH</span> <span class="crypto-price">$3,000</span> <span class="crypto-change price-up">▲ 1.8%</span></div>
            <div class="ticker-item"><span class="crypto-name">BNB</span> <span class="crypto-price">$500</span> <span class="crypto-change price-down">▼ 0.5%</span></div>
            <div class="ticker-item"><span class="crypto-name">XRP</span> <span class="crypto-price">$0.50</span> <span class="crypto-change price-up">▲ 3.2%</span></div>
            <div class="ticker-item"><span class="crypto-name">SOL</span> <span class="crypto-price">$150</span> <span class="crypto-change price-down">▼ 1.1%</span></div>
        `;
        tickerContainer.innerHTML += tickerContainer.innerHTML;
    }
}

// Initial load
fetchCryptoPrices();

// Refresh prices every 60 seconds
setInterval(fetchCryptoPrices, 60000);